---
title: 3D Models
description: 3D Printable Models for download
id: 3d
layout: default.webc
---
<p class="center">You can also find my designs on <a href="https://makerworld.com/en/@ZacharyC" target="_blank" title="Maker World Designs by Zachary Crespin">Maker World</a></p>
<div class="cards">
  {%- for design in collections.3d | reverse  | sort('order') -%}
    {% set loadingStrategy = "lazy" if loop.index0 > 2 else "eager" %}
    <div class="section {% if design.data.multiImage %}section-gallery{% else %}split{% endif %}" id="{{ design.data.id }}" aria-label="{{ design.data.title }}">
        {% if design.data.multiImage %}
        <div class="gallery {% if design.data.multiImage == 2 %}two-wide{% endif %}">
          {% for photo in design.data.imgs | limit(design.data.multiImage) %}
          <div class="photo">
              {% image photo, design.data.alts[loop.index0], "small", "(max-width: 900px) 100vw, 30vw", loadingStrategy %}
          </div>
          {% endfor %}
        </div>
        {% else %}
        {% image design.data.imgs[0], design.data.alts[0], "large", "(max-width: 900px) 100vw, 60vw", loadingStrategy %}
        {% endif %}
      <div class="text">
        <h2 class="h3">{{ design.data.title }}</h2>
        <p>{{ design.data.description }}</p>
        <p>{{ design.data.date | fullString }}</p>
        {% if design.data.modelLink %}<a class="button" href="{{ design.data.modelLink }}" target="_blank">Get 3D Model</a>{% endif %}
        {% if design.data.downloadLink %}<a class="button" href="{{ design.data.downloadLink }}" target="_blank">Download 3D Model</a>{% endif %}
      </div>
    </div>
    <hr>
  {%- endfor -%}
</div>
