---
layout: default.webc
eleventyComputed:
  seoTitle: "{{ title }} — Photography"
  description: "{{ title }} Photography by Zachary Crespin"
  shareImage: "{{ img }}"
---
<section class="gallery" aria-label="Gallery">
  {% for photo in collections[id] | sort("order") %}
    <a class="photo" href="/photography/{{ photo.data.id }}/?gallery={{ id }}">
      {% set loadingStrategy = "lazy" if loop.index0 > 5 else "eager" %}
      {% image photo.data.src, photo.data.alt, "small", "(max-width: 600px) 100vw, (max-width: 900px) 50vw, 33vw", loadingStrategy %}
    </a>
  {% endfor %}
</section>
